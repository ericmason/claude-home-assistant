# Copy this file to examples/.env and fill in your own values.
# examples/.env is gitignored. Never commit a real token.

# Your Home Assistant URL, including the scheme and port.
HA_URL=http://homeassistant.local:8123

# A long-lived access token. In Home Assistant, click your user name at the
# bottom of the sidebar, open the Security tab, scroll to Long-lived access
# tokens, and create one. The token is shown once.
HA_TOKEN=paste-your-long-lived-token-here
